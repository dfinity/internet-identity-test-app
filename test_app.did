type HeaderField = record { text; text; };

type HttpRequest = record {
    method: text;
    url: text;
    headers: vec HeaderField;
    body: blob;
    certificate_version: opt nat16;
};

type HttpResponse = record {
    status_code: nat16;
    headers: vec HeaderField;
    body: blob;
};

type AlternativeOriginsMode = variant {
    CertifiedContent;
    UncertifiedContent;
    Redirect: record { location: text; };
};

type AppMetadataMode = variant {
    CertifiedContent;
    Redirect: record { location: text; };
};

type CallerAttributes = record {
    /// Canister that signed the attributes attached to the caller's
    /// request (e.g. the Internet Identity canister). Empty when the
    /// caller is another canister or no `sender_info` was attached.
    signer: opt principal;
    /// Raw attribute payload as provided by the signer. The format is
    /// signer-defined; for II this is a Candid-encoded ICRC-3 `Value`.
    data: blob;
};

type InitArg = record {
    /// Extra callback URLs added to the ICRC-167 auth-callback allow-list, on
    /// top of the canister's own gateway origins (e.g. a custom domain like the
    /// e2e `nice-name.com`).
    auth_callbacks: vec text;
};

service : (opt InitArg) -> {
  whoami: () -> (principal) query;
  update_alternative_origins: (text, AlternativeOriginsMode) -> ();
  /// Sets /.well-known/ii-app-metadata, the permissionless app display
  /// metadata II reads. The document is an opaque string so tests can serve
  /// malformed, oversized and out-of-range documents as well as valid ones.
  /// Nothing is served at that path until this is called.
  update_app_metadata: (text, AppMetadataMode) -> ();
  http_request: (request: HttpRequest) -> (HttpResponse) query;
  /// Echoes the caller's signed attributes back to the client so e2e
  /// tests can verify the round-trip from II → frontend →
  /// `AttributeIdentity` → canister.
  caller_attributes: () -> (CallerAttributes);
  /// Sends a test notification through II's `notification_send`, from this
  /// canister as the sender. `ii` is II's backend canister id, `recipient`
  /// the user's per-app principal, `origin` the origin the user consented
  /// from. Returns a debug summary of II's response.
  send_notification: (ii: principal, recipient: principal, origin: text) -> (text);
}
