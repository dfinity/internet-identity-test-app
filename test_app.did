type HeaderField = record { text; text; };

type HttpRequest = record {
    method: text;
    url: text;
    headers: vec HeaderField;
    body: blob;
    certificate_version: opt nat16;
};

type HttpResponse = record {
    status_code: nat16;
    headers: vec HeaderField;
    body: blob;
};

type AlternativeOriginsMode = variant {
    CertifiedContent;
    UncertifiedContent;
    Redirect: record { location: text; };
};

type AppMetadataMode = variant {
    CertifiedContent;
    Redirect: record { location: text; };
};

type CallerAttributes = record {
    /// Canister that signed the attributes attached to the caller's
    /// request (e.g. the Internet Identity canister). Empty when the
    /// caller is another canister or no `sender_info` was attached.
    signer: opt principal;
    /// Raw attribute payload as provided by the signer. The format is
    /// signer-defined; for II this is a Candid-encoded ICRC-3 `Value`.
    data: blob;
};

type Member = record {
    who: principal;
    /// Joined or last sent, in nanoseconds since the epoch.
    last_active: nat64;
};

type ChatMessage = record {
    from: principal;
    text: text;
    at: nat64;
};

type Room = record {
    members: vec Member;
    messages: vec ChatMessage;
};

type Bucket = record {
    /// The instant the hour begins, nanoseconds since the epoch.
    start: nat64;
    sent: nat64;
    accepted: nat64;
    deferred: nat64;
    received: nat64;
    dropped: nat64;
};

type Misconfigured = variant { Origin; Sender; NotAuthorizedSender };

type MisconfiguredSince = record { why: Misconfigured; since: nat64 };

type NotificationMetrics = record {
    /// Up to 720 buckets, oldest first. Hours with no traffic are absent.
    hours: vec Bucket;
    /// Notifications waiting for Internet Identity to accept them.
    backlog: nat64;
    misconfigured: opt MisconfiguredSince;
};

/// What the notification library serves to Internet Identity on a pull.
type NotificationContent = record {
    title: text;
    body: text;
    url: opt text;
};

type InitArg = record {
    /// Extra callback URLs added to the ICRC-167 auth-callback allow-list, on
    /// top of the canister's own gateway origins (e.g. a custom domain like the
    /// e2e `nice-name.com`).
    auth_callbacks: vec text;
};

service : (opt InitArg) -> {
  whoami: () -> (principal) query;
  update_alternative_origins: (text, AlternativeOriginsMode) -> ();
  /// Sets /.well-known/ii-app-metadata, the permissionless app display
  /// metadata II reads. The document is an opaque string so tests can serve
  /// malformed, oversized and out-of-range documents as well as valid ones.
  /// Nothing is served at that path until this is called.
  update_app_metadata: (text, AppMetadataMode) -> ();
  http_request: (request: HttpRequest) -> (HttpResponse) query;
  /// Echoes the caller's signed attributes back to the client so e2e
  /// tests can verify the round-trip from II → frontend →
  /// `AttributeIdentity` → canister.
  caller_attributes: () -> (CallerAttributes);
  /// Joins the one chatroom, or refreshes the caller's activity if they are
  /// already in it. Returns whoever was evicted to make room: the room holds
  /// 100 members, and a join beyond that drops whoever has been quiet longest.
  chat_join: () -> (opt principal);
  /// Posts a message and notifies everyone else in the room through Internet
  /// Identity. Long messages are truncated, only the last 50 are kept, and
  /// the messages are wiped hourly.
  chat_send: (text) -> ();
  chat_room: () -> (Room) query;
  /// The notification library's delivery metrics, an hour per bucket.
  notification_metrics: () -> (NotificationMetrics) query;
  /// Points the notification library at an Internet Identity, in place of the
  /// `notification_sender` environment variable, for as long as this instance
  /// lives. Null goes back to the variable. The frontend chooses which
  /// Internet Identity a test runs against, so the canister has to be told.
  update_notification_sender: (opt principal) -> ();
  /// Called by Internet Identity, not by a client: the content of a
  /// notification this canister sent, and the report that one was delivered.
  _internet_identity_notification_content: (nat64) -> (opt NotificationContent) query;
  _internet_identity_notification_received: (nat64) -> ();
}
